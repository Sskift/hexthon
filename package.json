{
  "name": "hexthon",
  "version": "0.4.1",
  "description": "国服海克斯大乱斗外置助手 · OP.GG 资料与本地只读对局信息",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "start:panel": "electron . --panel",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node scripts/run-smoke.cjs",
    "test:api": "node scripts/run-api-smoke.cjs",
    "probe:overwolf": "node scripts/run-overwolf-probe.cjs",
    "sync": "node scripts/sync-data.cjs",
    "package": "node scripts/package.cjs",
    "start:assist": "electron . --assist",
    "start:paused": "electron . --assist --paused",
    "stop": "electron . --quit",
    "test:light": "node scripts/run-light-smoke.cjs",
    "test:shop-layout": "electron tests/shop-layout.fixture.cjs",
    "test:lifecycle": "node scripts/run-lifecycle-smoke.cjs",
    "test:native": "node scripts/check-native-helpers.cjs",
    "probe:roi": "node scripts/probe-roi-performance.cjs",
    "test:catalog": "node scripts/check-title-catalog.cjs",
    "probe:itemsets": "node scripts/check-native-itemsets-client.cjs",
    "verify:package": "node scripts/release-manifest.cjs",
    "probe:fps": "node scripts/probe-fps-performance.cjs",
    "prepare:fps": "node scripts/prepare-presentmon.cjs",
    "test:replay": "node scripts/run-replay-smoke.cjs",
    "test:panel-layout": "electron scripts/check-panel-layout.cjs",
    "archive:release": "python scripts/archive-release.py",
    "test:update-lifecycle": "node scripts/check-update-lifecycle.cjs",
    "verify:release": "node scripts/check-release.cjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "@electron/packager": "20.3.0"
  }
}
